  {{if .Rows}}<p class="sub">{{.StartLabel}} → {{.EndLabel}}</p>{{end}}
  {{if .Rides}}
  <section class="island evolution">
    <h2>Best dry 2-hour ride windows</h2>
    <table><thead><tr><th>Time</th><th>Rain %</th><th>Wind</th><th>Gusts</th><th>Feels</th><th>UV</th></tr></thead><tbody>
    {{range .Rides}}<tr><th>{{.Start}}–{{.End}}</th><td>{{.RainChance}}%</td><td>{{.Wind}}</td><td>{{.Gusts}}</td><td>{{.Feels}}°</td><td>{{.UV}}</td></tr>{{end}}
    </tbody></table>
  </section>
  {{else if .RideNote}}
  <p class="ride-note"><svg class="g-bike" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="6" cy="16" r="3.6"/><circle cx="18" cy="16" r="3.6"/><path d="M6 16 9.6 9.5h6M12 16 9.6 9.5M12 16l3.6-6.5L18 16M6 16h6M9.6 9.5l.2-1.8M8.5 7.7h2.7M15.6 9.5l-.8-2.7h2.3"/></svg>{{.RideNote}}</p>
  {{end}}

  {{if .Note}}<p class="empty">{{.Note}}</p>{{end}}

  {{if .TempChartSVG}}
  <section class="chart island">
    <p class="chart-key"><span class="key-item"><span class="dot" style="background:#f97316"></span>Temp</span>
      <span class="key-item"><span class="dot" style="background:#60a5fa"></span>Feels like</span></p>
    {{.TempChartSVG}}
  </section>
  {{end}}

  {{if .PrecipChartSVG}}
  <section class="chart island">
    <p class="chart-key"><span class="key-item"><span class="dot" style="background:#06b6d4"></span>Precipitation (mm/h)</span></p>
    {{.PrecipChartSVG}}
  </section>
  {{end}}

  {{if .Rows}}
  <section class="evolution island">
    <h2>By hour</h2>
    <table class="hourly-table">
      <thead>
        <tr>
          <th>Time</th><th>Temp<span class="mobile-detail">Feels</span></th><th class="wide-detail">Feels</th><th>Rain<span class="mobile-detail">Chance</span></th><th class="wide-detail">%</th><th>Wind<span class="mobile-detail">Gusts</span></th><th class="wide-detail">Gusts</th><th>UV</th>
        </tr>
      </thead>
      <tbody>
        {{range .Rows}}
        <tr{{if .NewDay}} class="newday"{{end}}>
          <th>{{.Time}}</th>
          <td><span class="temp-condition"><details class="sky-condition"><summary aria-label="{{.Condition}}" title="{{.Condition}}"><span aria-hidden="true">{{.ConditionIcon}}</span></summary><span class="sky-label">{{.Condition}}</span></details><span>{{.Temp}}°</span></span><span class="mobile-detail muted" aria-label="Feels like {{.Feels}} degrees">{{.Feels}}°</span></td>
          <td class="muted wide-detail">{{.Feels}}°</td>
          <td>{{if .Precip}}{{.Precip}}{{else}}·{{end}}<span class="mobile-detail muted" aria-label="Rain chance {{.PrecipPct}} percent">{{.PrecipPct}}%</span></td>
          <td class="muted wide-detail">{{if .PrecipPct}}{{.PrecipPct}}{{end}}</td>
          <td><span class="wind-value g-mi-{{.WindClass}}">{{.WindArrow}} {{.WindKmh}}</span><span class="mobile-detail g-mi-{{.GustClass}}" aria-label="Gusts {{.GustsKmh}} kilometres per hour">{{.GustsKmh}}</span></td>
          <td class="g-mi-{{.GustClass}} wide-detail">{{.GustsKmh}}</td>
          <td class="g-mi-{{.UVClass}}">{{.UV}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </section>

  <section class="legend-card">
    <h3>Legend</h3>
    <div class="legend-group">
      <p class="legend-line">→ arrow points where the wind pushes you · <span class="g-mi-caution">caution</span> wind/gusts ≥28&nbsp;km/h, UV ≥3 · <span class="g-mi-critical">critical</span> ≥50&nbsp;km/h, UV ≥8</p>
      {{if .Period}}<p class="legend-line">Ride windows: 2 dry daylight hours, rain chance ≤30%, gusts under 50&nbsp;km/h, best first</p>{{end}}
    </div>
  </section>
  {{end}}

  <footer>Forecast: <a href="https://open-meteo.com/">Open-Meteo</a></footer>
</main>
<script>
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(function(){});
</script>
</body>
</html>
