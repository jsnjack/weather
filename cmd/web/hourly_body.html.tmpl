  {{if .Period}}
  {{if .Rows}}<p class="sub">{{.StartLabel}} → {{.EndLabel}} · Times are local to {{.Location.Description}}.</p>{{end}}
  <section class="island evolution">
    <h2>Best dry 2-hour ride windows</h2>
    <p class="sub">Ranked by rain chance, wind, gusts, feels-like temperature and UV. Daylight only; rain chance ≤30%; gusts below 50 km/h.</p>
    {{if .Rides}}<table><thead><tr><th>Time</th><th>Rain %</th><th>Wind</th><th>Gusts</th><th>Feels</th><th>UV</th></tr></thead><tbody>
    {{range .Rides}}<tr><th>{{.Start}}–{{.End}}</th><td>{{.RainChance}}%</td><td>{{.Wind}}</td><td>{{.Gusts}}</td><td>{{.Feels}}°</td><td>{{.UV}}</td></tr>{{end}}
    </tbody></table>{{else}}{{if not .Note}}<p>No suitable daylight window in the forecast.</p>{{end}}{{end}}
  </section>
  {{end}}

  {{if .Note}}<p class="empty">{{.Note}}</p>{{end}}

  {{if .TempChartSVG}}
  <section class="chart island">
    <p class="chart-key"><span class="key-item"><span class="dot" style="background:#f97316"></span>Temp</span>
      <span class="key-item"><span class="dot" style="background:#60a5fa"></span>Feels like</span></p>
    {{.TempChartSVG}}
  </section>
  {{end}}

  {{if .PrecipChartSVG}}
  <section class="chart island">
    <p class="chart-key"><span class="key-item"><span class="dot" style="background:#06b6d4"></span>Precipitation (mm/h)</span></p>
    {{.PrecipChartSVG}}
  </section>
  {{end}}

  {{if .Rows}}
  <section class="evolution island">
    <h2>By hour</h2>
    <table class="hourly-table">
      <thead>
        <tr>
          <th>Time</th><th>Temp<span class="mobile-detail">Feels</span></th><th class="wide-detail">Feels</th><th>Rain<span class="mobile-detail">Chance</span></th><th class="wide-detail">%</th><th>Wind<span class="mobile-detail">Gusts</span></th><th class="wide-detail">Gusts</th><th>UV</th><th>Sky</th>
        </tr>
      </thead>
      <tbody>
        {{range .Rows}}
        <tr{{if .NewDay}} class="newday"{{end}}>
          <th>{{.Time}}</th>
          <td>{{.Temp}}°<span class="mobile-detail muted" aria-label="Feels like {{.Feels}} degrees">{{.Feels}}°</span></td>
          <td class="muted wide-detail">{{.Feels}}°</td>
          <td>{{if .Precip}}{{.Precip}}{{else}}·{{end}}<span class="mobile-detail muted" aria-label="Rain chance {{.PrecipPct}} percent">{{.PrecipPct}}%</span></td>
          <td class="muted wide-detail">{{if .PrecipPct}}{{.PrecipPct}}{{end}}</td>
          <td><span class="wind-value g-mi-{{.WindClass}}">{{.WindArrow}} {{.WindKmh}}</span><span class="mobile-detail g-mi-{{.GustClass}}" aria-label="Gusts {{.GustsKmh}} kilometres per hour">{{.GustsKmh}}</span></td>
          <td class="g-mi-{{.GustClass}} wide-detail">{{.GustsKmh}}</td>
          <td class="g-mi-{{.UVClass}}">{{.UV}}</td>
          <td class="sky-cell"><details class="sky-condition"><summary aria-label="{{.Condition}}" title="{{.Condition}}"><span aria-hidden="true">{{.ConditionIcon}}</span></summary><span class="sky-label">{{.Condition}}</span></details></td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </section>

  <section class="legend-card">
    <h3>Legend</h3>
    <div class="legend-group">
      <span class="legend-item">Temp / Feels — °C</span>
      <span class="legend-item">Rain — mm in the hour · % — chance of rain</span>
      <span class="legend-item">Wind / gusts — km/h · arrow points where it pushes you</span>
      <span class="legend-item"><span class="g-mi-caution">caution</span> wind/gusts ≥28 / UV ≥3 · <span class="g-mi-critical">critical</span> wind/gusts ≥50 / UV ≥8</span>
    </div>
  </section>
  {{end}}

  <footer>refreshed {{.Now}}</footer>
</main>
<script>
  if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(function(){});
</script>
</body>
</html>
