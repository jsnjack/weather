  {{if .ChartSVG}}<section class="chart island">{{.ChartSVG}}</section>{{end}}

  {{if .HasGlance}}
  <section class="glance-cells{{if .IsDry}} hero{{end}}">
    <div class="cell-now island-accent">
      <span class="microlabel">now</span>
      <span class="cell-temp">{{.TempNow}}°</span>
      {{if .ConditionLabel}}<span class="cell-cond">{{.ConditionLabel}}</span>{{end}}
      <span class="cell-plus"><span class="microlabel">+2h</span>{{.TempEnd}}°</span>
      {{if .SunEvents}}
      <span class="cell-sun">{{range .SunEvents}}<span>{{.Glyph}} {{.Time}}</span>{{end}}</span>
      {{end}}
    </div>
    <div class="cell-stats island">
      <table class="stats">
        <thead><tr><th></th><th>now</th><th>+2h</th></tr></thead>
        <tbody>
          <tr>
            <th>Feels</th>
            <td>{{.FeelsNow}}°</td>
            <td class="end">{{.FeelsEnd}}°</td>
          </tr>
          <tr>
            <th>Wind</th>
            <td class="g-mi-{{.WindNow.Class}}">{{.WindNow.Arrow}} {{.WindNow.Kmh}}</td>
            <td class="end g-mi-{{.WindEnd.Class}}">{{.WindEnd.Arrow}} {{.WindEnd.Kmh}}</td>
          </tr>
          <tr>
            <th>UV</th>
            <td class="g-mi-{{.UVNow.Class}}">{{.UVNow.Value}}</td>
            <td class="end g-mi-{{.UVEnd.Class}}">{{.UVEnd.Value}}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
  {{end}}

  {{if .Description}}<p class="caption">{{.Description}}</p>{{end}}

  <section class="radar island" id="radar-player" data-location="{{.Q}}" data-timezone="{{.Timezone}}">
    <div class="radar-views" role="group" aria-label="Radar coverage">
      <button type="button" data-view="local" aria-pressed="false" disabled title="Checking local radar">Local</button>
      <button type="button" data-view="national" aria-pressed="true">Netherlands</button>
    </div>
    <img id="local-radar" data-local-map hidden alt="Observed rain within 50 km of your location" width="256" height="256">
    <img data-national-fallback hidden alt="KNMI precipitation and lightning radar over the Netherlands" width="425" height="445">
    <canvas hidden width="425" height="445" role="img" aria-label="KNMI precipitation and lightning radar over the Netherlands"></canvas>
    <noscript><picture><source media="(prefers-color-scheme: dark)" srcset="/radar.gif?theme=dark"><img src="/radar.gif" alt="KNMI precipitation and lightning radar over the Netherlands" width="425" height="445"></picture></noscript>
    <div class="radar-controls" hidden>
      <label class="radar-slider"><input type="range" min="0" max="0" value="0" aria-label="Radar frame"></label>
      <div class="radar-actions"><button type="button" data-play>Play</button><button type="button" data-now hidden aria-label="Now: latest observation" title="Latest observation">Now</button><button type="button" data-latest>Latest frame</button><output class="sub"></output></div>
      <p class="sub" data-help>Earlier ← → Later · Now selects the latest observation. Timestamp shown on the map; later frames may be forecasts.</p>
      <p class="sub radar-progress" data-progress hidden role="status"></p>
    </div>
    <p class="sub radar-credit" hidden>Map: <a href="https://www.pdok.nl/introductie/-/article/basisregistratie-topografie-achtergrondkaarten-brt-a-">Kadaster / PDOK</a> · Rain: <a href="https://dataplatform.knmi.nl/dataset/radar-reflectivity-composites-2-0">KNMI</a></p>
    <p class="sub radar-note" hidden></p>
  </section>
  <script src="/static/radar.js?v=9"></script>

  <footer>refreshed {{.Now}}</footer>
</main>
<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js").catch(function (e) { console.warn("SW", e); });
  }
</script>
</body>
</html>
