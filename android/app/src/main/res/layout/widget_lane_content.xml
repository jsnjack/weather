<?xml version="1.0" encoding="utf-8"?>
<!--
  Rain lane contents, shared by both widget layouts. The title is always the
  nowcast sentence; below it exactly one of chart, dry_rows or lane_note shows.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/lane_title"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:ellipsize="end"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/widget_text"
        android:textFontWeight="600"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/chart_description"
        android:forceDarkAllowed="false"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/dry_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dry_radar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView style="@style/WidgetDryKey" android:text="@string/radar_label" />

            <TextView android:id="@+id/dry_radar" style="@style/WidgetDryValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dry_sunset_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView style="@style/WidgetDryKey" android:text="@string/sunset_label" />

            <TextView android:id="@+id/dry_sunset" style="@style/WidgetDryValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/lane_note"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text=""
        android:textColor="@color/widget_subtle"
        android:textSize="11sp"
        android:visibility="gone" />
</merge>
