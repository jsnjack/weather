<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacked layout, ROW variant (WidgetPlanner) for short widgets such as 4×1:
  a compact conditions panel, the rain lane and a square map in one row.
  View IDs match widget_stacked.xml so one renderer fills both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/cond"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:background="@drawable/island_accent"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="8dp"
        android:paddingEnd="9dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/loading"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/condition"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@string/condition_description"
                android:src="@drawable/ic_cond_clear"
                android:tint="@color/chart_temp"
                tools:ignore="UseAppTint" />

            <TextView
                android:id="@+id/temp_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_text"
                android:textFontWeight="300"
                android:textSize="26sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/WidgetLabel"
                android:layout_marginEnd="3dp"
                android:text="@string/plus2h_label" />

            <TextView
                android:id="@+id/temp_end"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/chart_temp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text=""
                android:textColor="@color/widget_subtle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/island_neutral"
        android:orientation="vertical">

        <include layout="@layout/widget_lane_content" />
    </LinearLayout>

    <include
        layout="@layout/widget_map"
        android:layout_width="86dp"
        android:layout_height="match_parent" />
</LinearLayout>
