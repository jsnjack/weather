<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="2dp">
        <ImageView android:id="@+id/condition" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_cond_clear" android:contentDescription="@string/widget_label" />
        <TextView android:id="@+id/location" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_text" android:textSize="12sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:text="@string/loading" />
        <TextView android:id="@+id/updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/widget_subtle" android:textSize="12sp" android:singleLine="true" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/updated_pill_background" android:text="" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:layout_marginEnd="6dp" android:orientation="vertical">
            <ImageView android:id="@+id/chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:scaleType="fitXY" android:adjustViewBounds="false" android:background="@drawable/island_neutral" android:contentDescription="@string/widget_label" />
            <LinearLayout android:id="@+id/rain_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="0dp" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="@string/now_label" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" android:id="@+id/rain_temp_now" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" android:id="@+id/rain_micro_now" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="@string/plus2h_label" />
                    <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" android:id="@+id/rain_temp_end" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_text" android:singleLine="true" android:text="" android:id="@+id/rain_micro_end" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/dry_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="0dp" android:orientation="vertical" android:visibility="gone" android:background="@drawable/island_neutral">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:background="@drawable/island_accent" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_subtle" android:textSize="10sp" android:textFontWeight="700" android:letterSpacing="0.16" android:text="@string/now_label" android:layout_marginEnd="5dp" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="0dp" android:layout_marginEnd="8dp">
                        <ImageView android:id="@+id/dry_condition" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_cond_clear" android:contentDescription="@string/widget_label" />
                        <TextView android:id="@+id/dry_temp_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="32sp" android:textFontWeight="300" android:includeFontPadding="false" android:text="" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="0dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_subtle" android:textSize="10sp" android:textFontWeight="700" android:letterSpacing="0.16" android:layout_marginEnd="6dp" android:text="@string/plus2h_label" />
                        <TextView android:id="@+id/dry_temp_end" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/chart_temp" android:textSize="17sp" android:textFontWeight="600" android:text="" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/island_neutral" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="1dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="" />
                        <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_subtle" android:textSize="9sp" android:textFontWeight="700" android:letterSpacing="0.1" android:text="@string/now_label" />
                        <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_subtle" android:textSize="9sp" android:textFontWeight="700" android:letterSpacing="0.1" android:text="@string/plus2h_label" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="1dp" android:paddingBottom="1dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="@string/stat_feels" />
                        <TextView android:id="@+id/dry_feels_now" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_text" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                        <TextView android:id="@+id/dry_feels_end" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="1dp" android:paddingBottom="1dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="@string/stat_wind" />
                        <TextView android:id="@+id/dry_wind_now" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_text" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                        <TextView android:id="@+id/dry_wind_end" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="1dp" android:paddingBottom="1dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="@string/stat_uv" />
                        <TextView android:id="@+id/dry_uv_now" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_text" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                        <TextView android:id="@+id/dry_uv_end" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_subtle" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/dry_sunset_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingTop="1dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_subtle" android:textSize="10sp" android:textFontWeight="700" android:letterSpacing="0.16" android:layout_marginEnd="6dp" android:text="@string/sunset_label" />
                    <TextView android:id="@+id/dry_sunset_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="11sp" android:textFontWeight="600" android:text="" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/local_radar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/radar_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:forceDarkAllowed="false" android:contentDescription="@string/radar_description" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/widget_subtle" android:textSize="11sp" android:gravity="center_horizontal" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="0.98" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="" />
</LinearLayout>
